<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What a signed build is allowed to do. Ignored entirely until somebody signs one — there is no
  Apple certificate in this repository and there should not be — and wrong to leave until then,
  because the hardened runtime a notarised app must use denies microphone input by default. The
  first signed build would install, open, and be unable to record, and the cause would be a file
  that did not exist.

  Deliberately short. An app that promises audio never leaves the machine should not be asking for
  the network, the camera, or a user's documents.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
