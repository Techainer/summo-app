<?xml version="1.0" encoding="utf-8"?>
<!--
  The app is allowed to talk to itself, and to nothing else in the clear.

  The engine runs *inside* this process and the webview reaches it over loopback — same routes,
  same token, same protocol as the desktop sidecar (see `apps/mobile/README.md`). That is an
  `http://127.0.0.1:<port>` request, and a release build sets `usesCleartextTraffic="false"`, so
  Android refused every one of them. The app opened, drew its interface, started its daemon, and
  showed "Failed to fetch" where the vault should be — on a socket it was listening on itself.

  Nobody had seen it because nobody had run a release build: the debug build sets the same
  placeholder to "true", so the one configuration that works is the one nobody ships.

  `usesCleartextTraffic="false"` stays as the base rule. This is not a loosening of it — cleartext
  to any real host is still refused, which is what that flag is for. It is an exception for two
  names that cannot leave the device: loopback is the machine talking to itself, and there is no
  network segment for anyone to sit on. TLS there would mean shipping a certificate and a private
  key inside every copy of the app, which is worse than the thing it would be protecting against.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
