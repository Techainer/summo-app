<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- What the app is for. Without this it installs, opens, and cannot record a thing. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Not optional, and not obvious. The interface records through `getUserMedia`, which in an
         Android WebView goes to `WebChromeClient.onPermissionRequest`. Wry's implementation of
         that asks the system for RECORD_AUDIO *and* MODIFY_AUDIO_SETTINGS together, and grants the
         page only if **every** permission in the request came back granted. Android refuses a
         permission the manifest never declared, so without this line the second half of the pair
         is denied at once, the whole request is denied with it, and `getUserMedia` rejects — after
         the user has tapped Allow. A microphone that is refused because of a permission nobody
         asked for and no dialog ever mentioned.

         It is a normal permission, so declaring it is the whole of the work: it is granted at
         install and the user is never asked about it. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Recording has to survive the screen going off. A meeting is forty minutes and a phone
         sleeps in two, and a foreground service is the only way Android lets an app keep the
         microphone open across that. `microphone` is the type Android requires be declared for
         one that records — the generic type is rejected at install on API 34. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A microphone is required; a touchscreen is not, since this also installs on a TV. -->
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!--
      `networkSecurityConfig` is what makes a release build able to reach its own engine. The flag
      below is false in release, which refuses every `http://127.0.0.1:<port>` request the webview
      makes to the daemon running inside this same process; the config carves out loopback and
      leaves the refusal in place for everywhere else. See `res/xml/network_security_config.xml`.
    -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.summo_mobile"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
